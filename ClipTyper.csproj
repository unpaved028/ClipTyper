<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>media\ClipTyper.ico</ApplicationIcon>
    <Version>1.8.0</Version>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <!-- Release build optimizations: partial trimming + compression.
       NETSDK1175 suppressed because TrimMode=partial is safe for WinForms —
       it only trims assemblies explicitly annotated as trim-safe. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <!-- Trimming WinForms causes TypeLoadExceptions at runtime on Context Menu and Exit. -->
    <PublishTrimmed>false</PublishTrimmed>
    <!-- Compression is only supported for self-contained applications -->
    <EnableCompressionInSingleFile Condition="'$(SelfContained)' == 'true'">true</EnableCompressionInSingleFile>
    <!-- Prevent TypeLoadException in WinForms single-file by extracting all DLLs -->
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <!-- Allow COM Interop for IShellLink -->
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
  </PropertyGroup>

  <ItemGroup>
    <!-- Multi-size icon (16-256 px) for tray, EXE and the large overlay; generated by media/build_icon.py -->
    <EmbeddedResource Include="media\ClipTyper.ico" LogicalName="ClipTyper.icon_app.ico" />
    <!-- Single 256 px frame for the large overlay: System.Drawing.Icon does not pick the 256 px frame
         (stored as size 0) out of a multi-size icon, Win32 does -->
    <EmbeddedResource Include="media\ClipTyper_256.ico" LogicalName="ClipTyper.icon_large.ico" />
    <EmbeddedResource Include="media\ClipTyper_128.ico" LogicalName="ClipTyper.icon_overlay.ico" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ClipTyper.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="ClipTyper.Tests\**" />
    <EmbeddedResource Remove="ClipTyper.Tests\**" />
    <None Remove="ClipTyper.Tests\**" />
  </ItemGroup>

</Project>
